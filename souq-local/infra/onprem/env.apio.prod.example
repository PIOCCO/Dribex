# Copy to .env.apio.prod — never commit real values.
# APIO only; Dribex .env.prod is separate.

NODE_ENV=production
PORT=3001
STRICT_CONFIG=true

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

ALLOWED_ORIGINS=https://dribex.ma,https://www.dribex.ma
FRONTEND_URL=https://dribex.ma/APIO

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG
SUPER_ADMIN_NAME=Super Admin

# Web OAuth client dedicated to APIO (not the Android client)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://dribex.ma/APIO/api/auth/google/callback

# Email (required in production for verify / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@dribex.ma
EMAIL_FROM_NAME=APIO

UPLOAD_MAX_BYTES=10485760

# Paths inside apio-server container (defaults match Dockerfile.server)
DATABASE_PATH=/data/apio.sqlite
UPLOAD_DIR=/data/uploads
